#!/bin/sh
set +e

find_jb() {
    if [ -n "${JBROOT:-}" ] && [ -d "$JBROOT/usr" ]; then
        printf '%s' "$JBROOT"
        return 0
    fi
    for candidate in /var/jb /var/containers/Bundle/Application/.jbroot-*; do
        if [ -d "$candidate/usr" ] || [ -d "$candidate/Library/MobileSubstrate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    printf ''
}

JB="$(find_jb)"

UICACHE=""
for candidate in "${JB}/usr/bin/uicache" /var/jb/usr/bin/uicache /usr/bin/uicache; do
    [ -n "$candidate" ] && [ -x "$candidate" ] && UICACHE="$candidate" && break
done
if [ -z "$UICACHE" ]; then
    UICACHE="$(command -v uicache 2>/dev/null)"
fi

if [ -n "$UICACHE" ]; then
    for app in "${JB}/Applications/Heli.app" /var/jb/Applications/Heli.app; do
        [ -n "$app" ] && "$UICACHE" -p "$app" >/dev/null 2>&1
    done
fi

KILLALL=""
for candidate in "${JB}/usr/bin/killall" /var/jb/usr/bin/killall /usr/bin/killall; do
    [ -n "$candidate" ] && [ -x "$candidate" ] && KILLALL="$candidate" && break
done

if [ -n "$KILLALL" ]; then
    "$KILLALL" -9 SpringBoard >/dev/null 2>&1
fi

exit 0
