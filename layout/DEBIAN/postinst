#!/bin/sh
# 装完立刻让桌面出现 liquid 图标，否则用户只会看到一个"啥也没有"的包。
set +e

JB="/var/jb"
[ -d "$JB" ] || JB=""

APP="${JB}/Applications/Heli.app"

UICACHE=""
for candidate in "${JB}/usr/bin/uicache" /usr/bin/uicache; do
    if [ -x "$candidate" ]; then
        UICACHE="$candidate"
        break
    fi
done

if [ -n "$UICACHE" ] && [ -d "$APP" ]; then
    "$UICACHE" -p "$APP" >/dev/null 2>&1
fi

KILLALL=""
for candidate in "${JB}/usr/bin/killall" /usr/bin/killall; do
    if [ -x "$candidate" ]; then
        KILLALL="$candidate"
        break
    fi
done

if [ -n "$KILLALL" ]; then
    "$KILLALL" -9 SpringBoard >/dev/null 2>&1
fi

exit 0
