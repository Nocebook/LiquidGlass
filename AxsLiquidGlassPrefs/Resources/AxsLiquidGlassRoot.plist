<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>完美液态玻璃</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>总开关</string>
            <key>footerText</key><string>关闭后立即恢复系统原生模糊，不需要注销。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><false/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>玻璃质感</string>
            <key>footerText</key><string>半径越大越像磨砂厚玻璃；饱和度决定底色透不透。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidGlassSliderCell</string>
            <key>label</key><string>模糊半径</string>
            <key>key</key><string>blurRadius</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><real>46.0</real>
            <key>min</key><real>12.0</real>
            <key>max</key><real>80.0</real>
            <key>decimals</key><integer>0</integer>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidGlassSliderCell</string>
            <key>label</key><string>色彩饱和度</string>
            <key>key</key><string>saturation</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><real>1.7</real>
            <key>min</key><real>1.0</real>
            <key>max</key><real>2.2</real>
            <key>decimals</key><integer>1</integer>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidGlassSliderCell</string>
            <key>label</key><string>乳白浓度</string>
            <key>key</key><string>tintAlpha</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><real>0.06</real>
            <key>min</key><real>0.0</real>
            <key>max</key><real>0.2</real>
            <key>decimals</key><integer>2</integer>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidGlassSliderCell</string>
            <key>label</key><string>高光强度</string>
            <key>key</key><string>rimStrength</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><real>0.35</real>
            <key>min</key><real>0.0</real>
            <key>max</key><real>1.0</real>
            <key>decimals</key><integer>2</integer>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>作用范围</string>
            <key>footerText</key><string>键盘默认关闭：高光会压住候选字。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>主屏、Dock 与文件夹</string>
            <key>key</key><string>scopeHome</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>控制中心</string>
            <key>key</key><string>scopeControlCenter</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>通知与弹窗</string>
            <key>key</key><string>scopeAlerts</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>键盘</string>
            <key>key</key><string>scopeKeyboard</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><false/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>小组件</string>
            <key>footerText</key><string>小组件进程内存只有 30~50MB、渲染窗口 8~10 秒，超限会被系统杀掉并直接空白。默认「边缘折光」不新增任何图层，只改模糊参数和描边；「完整效果」会加高光图层，少数组件可能撑不住，出问题就退回上一档，或把包名填进跳过列表。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSListItemsCell</string>
            <key>label</key><string>小组件处理</string>
            <key>key</key><string>widgetMode</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><integer>2</integer>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
                <integer>2</integer>
                <integer>3</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>完全跳过</string>
                <string>仅调参数</string>
                <string>边缘折光（推荐）</string>
                <string>完整效果（实验）</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>跳过列表</string>
            <key>key</key><string>widgetBlocklist</string>
            <key>defaults</key><string>com.axs.liquidglass</string>
            <key>default</key><string>autonavi,amap</string>
            <key>placeholder</key><string>逗号分隔，匹配包名子串</string>
        </dict>
    </array>
</dict>
</plist>
